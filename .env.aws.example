# AWS 개인용 서버(EC2 my-macro-app)의 .env — 이름만 적습니다(값은 서버의 ~/My_macro_dashboard_v2/.env에만, chmod 600).
# compose.aws.yml · ADR 0019 참고.
#
# 서버 .env = 로컬 .env(.env.example의 이름들)에서 아래 '적지 않는 이름'을 뺀 것 + 아래 '서버 전용' 두 줄.
#
# ⚠️ 서버 .env에 적지 않는 이름 — scripts/aws/deploy.sh는 COOKIE_SECURE·PAPER_ENABLED 밖의 이름이 있으면 배포하지 않습니다(이름만 알림)
#   · 포트 네 줄 DATABASE_PORT·BACKEND_PORT·COLLECTOR_PORT·FRONTEND_PORT — 로컬은 v3·v1과 함께 띄우려고 5434/8082/8002/3002를
#     쓰지만, 서버는 기본값(127.0.0.1의 5432/8080/8000/3000)을 씁니다. 앞단 Caddy는 컨테이너 안 포트로 붙습니다.
#   · COOKIE_SECURE — 로컬 값(false)이 들어오면 compose.aws.yml의 기본값 true(세션 쿠키에 Secure)를 덮어씁니다.
#     브라우저가 터널 화면에서 로그인 쿠키를 받지 못할 때만 COOKIE_SECURE=false를 적고 ADR 0019에 기록합니다.
#   · LOCAL_NO_LOGIN·FRONTEND_ORIGIN·PUBLIC_URL — compose.aws.yml이 값을 박아 두어 적어도 쓰이지 않습니다(로그인은 늘 켜짐, ADR 0016).
#   · AWS_INSTANCE_ID — PC의 scripts/aws/tunnel.sh만 읽습니다.
#   · PAPER_ENABLED — 전환 뒤 로컬 .env의 false를 옮기지 않습니다(서버는 비우면 켜짐). 서버를 일부러 끌 때만 서버에서 직접 적습니다.
#
# 🧪 모의 매매 정기 작업은 이 서버 한 곳에서만 돕니다 — PAPER_ENABLED는 평소 비우거나 true. 전환 뒤 로컬 v1의 .env는 PAPER_ENABLED=false.

# ── 서버 전용 ──
# compose 파일 두 개를 늘 함께 읽게 합니다 — 서버에서 make backup·make restore·make logs·docker compose ps가 덧붙임까지 봅니다
# (deploy.sh·backup-s3.sh는 이 값과 상관없이 같은 값을 씀). 비밀값이 아니라 이 값 그대로 적습니다.
COMPOSE_FILE=docker-compose.yml:compose.aws.yml
# DB 백업을 올릴 S3 버킷 이름(scripts/aws/backup-s3.sh, cron 매일 06:10 KST). 서버의 IAM 역할이 이 버킷 하나에만 쓸 수 있습니다.
AWS_BACKUP_BUCKET=

# ── 공개 주소(CloudFront + 잠금화면, ADR 0019 결정 16) ──
# 비밀값(ORIGIN_SECRET·GATE_SECRET·GATE_CODES·TELEGRAM_BOT_TOKEN)은 화면·로그·커밋에 내지 않습니다. 값은 서버 .env에만.
# CloudFront 배포판의 기본 주소(https://dXXXX.cloudfront.net) — 계정 고유 값이라 저장소에 적지 않습니다. 백엔드 허용 출처에 더해집니다.
PUBLIC_ORIGIN=
# CloudFront가 원본 요청에 붙이는 X-Origin-Verify 헤더 값(배포판 설정과 같은 값, 32자 이상 임의 문자열). 없으면 caddy가 뜨지 않습니다.
ORIGIN_SECRET=
# 잠금화면 쿠키 서명 키(32자 이상 임의 문자열)
GATE_SECRET=
# 접근 코드 — "이름:scrypt해시,이름:해시". 해시는 PC에서 `python3 deploy/aws/gate/gate.py hash`(코드는 stdin)로 만들고, 코드 평문은 서버에 두지 않습니다.
GATE_CODES=
# (선택) 잠금화면에 적을 운영 시간 — 비우면 compose.aws.yml의 기본 문구
GATE_HOURS=
# (선택) 잠금 해제·차단 텔레그램 알림 — 둘 다 있어야 보냅니다
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
