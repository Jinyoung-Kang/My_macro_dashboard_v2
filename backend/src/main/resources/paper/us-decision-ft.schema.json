{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stance", "targetEquityExposurePct", "exposureRationale", "summary", "orders", "noTradeReason", "confidence"],
  "properties": {
    "schemaVersion": {"const": 2},
    "stance": {"enum": ["RISK_ON", "RISK_OFF", "NEUTRAL", "UNCERTAIN"]},
    "targetEquityExposurePct": {"type": "number", "minimum": 0, "maximum": 100},
    "exposureRationale": {"type": "string", "maxLength": 600},
    "summary": {"type": "string", "maxLength": 1200},
    "orders": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "side", "timing", "executionNote", "thesis", "labels", "invalidation"],
        "properties": {
          "ticker": {"type": "string", "pattern": "^[A-Z.\\-]{1,8}$"},
          "side": {"enum": ["BUY", "SELL"]},
          "targetWeightPct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "sellFraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "timing": {"enum": ["NEXT_OPEN", "AT_MINUTE", "NEXT_CLOSE"]},
          "atLocal": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
          "executionNote": {"type": "string", "maxLength": 200},
          "thesis": {"type": "string", "maxLength": 600},
          "labels": {"type": "array", "items": {"enum": ["사실", "해석", "가설", "확인 필요", "결정"]}},
          "invalidation": {"type": "string", "maxLength": 300}
        }
      }
    },
    "noTradeReason": {"type": ["string", "null"], "maxLength": 600},
    "watchlist": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "condition"],
        "properties": {
          "ticker": {"type": "string"},
          "condition": {"type": "string", "maxLength": 300}
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "feed", "watch", "question"],
        "properties": {
          "at": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
          "feed": {"enum": ["MINUTE", "HOURLY"]},
          "watch": {"type": "array", "maxItems": 10, "items": {"type": "string", "pattern": "^[A-Z.\\-]{1,8}$"}},
          "question": {"type": "string", "maxLength": 300}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
