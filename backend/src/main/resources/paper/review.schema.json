{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "weekEnding", "verdicts", "recurringErrors", "keep", "watchItems", "proposal"],
  "properties": {
    "schemaVersion": {"const": 2},
    "weekEnding": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "verdicts": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decisionId", "thesisHeld", "note"],
        "properties": {
          "decisionId": {"type": "integer", "minimum": 1},
          "thesisHeld": {"enum": ["유지", "반증", "판단불가"]},
          "note": {"type": "string", "maxLength": 400}
        }
      }
    },
    "recurringErrors": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 300}
    },
    "keep": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 300}
    },
    "watchItems": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 300}
    },
    "proposal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["operations", "judgment", "rationale"],
      "properties": {
        "operations": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "target", "text", "why"],
            "properties": {
              "op": {"enum": ["ADD_RULE", "UPDATE_RULE", "DELETE_RULE", "ADD_PRINCIPLE", "UPDATE_PRINCIPLE", "DELETE_PRINCIPLE"]},
              "target": {"type": "string", "maxLength": 20},
              "text": {"type": ["string", "null"], "maxLength": 300},
              "why": {"type": "string", "maxLength": 400}
            }
          }
        },
        "judgment": {"type": "string", "maxLength": 800},
        "rationale": {"type": "string", "maxLength": 1500}
      }
    }
  }
}
