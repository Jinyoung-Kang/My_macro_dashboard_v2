절. noPriceTickers(이번 관측치에서 이어 쓴 봉 = 8_prices의 stale, 관측치 봉이 없는 보유)의 주문은 매수·매도 모두 NO_PRICE로 거절. 관측치 저장본(quotesCollectedAtKst)이 검증 시각보다 24시간 넘게 오래되면 그날 주문 전부 거절(STALE_INPUT) — inputsStale이 true면 지금 그 상태다.","주문은 기준 거래일 뒤 세션의 관측치(NEXT_OBSERVATION) 또는 확정 종가(NEXT_CLOSE)로 체결된다 — 기준 거래일 봉으로는 체결되지 않는다.","9_portfolio.pendingOrders(앞선 결정의 대기 주문): 이번 결정의 응답이 형식 검사를 통과하면(주문이 없거나 모두 거절돼도) 위 대기 주문은 모두 취소된다 — 유지하려면 다시 내라."],"maxWeightStockPct":10,"maxWeightEtfPct":20,"maxPositions":20,"minOrderNotional":500,"maxDiscretionaryOrdersPerMonth":20,"minHoldTradingDaysForSell":5,"trailingStopPct":8,"lockoutTradingDays":20,"cashLikeTickers":["SHY"],"etfTickers":["DBC","GLD","IEF","QQQ","SHY","SPY","TLT","UUP","XLB","XLC","XLE","XLF","XLI","XLK","XLP","XLRE","XLU","XLV","XLY"],"lockedOut":["XLE"],"noPriceTickers":[],"inputsStale":false,"quotesCollectedAtKst":"2026-10-27 05:30 KST","universeSize":9,"universe":"AAA,BBB,CCC,DDD,EEE,OLD,SHY,SPY,XLK"}}
