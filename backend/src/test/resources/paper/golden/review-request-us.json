{
  "max_tokens" : 16000,
  "messages" : [ {
    "content" : "<<고정본 review-user-us.txt>>",
    "role" : "user"
  } ],
  "model" : "claude-sonnet-5-5",
  "output_config" : {
    "effort" : "high",
    "format" : {
      "schema" : {
        "type" : "object",
        "additionalProperties" : false,
        "required" : [ "schemaVersion", "weekEnding", "verdicts", "recurringErrors", "keep", "proposal" ],
        "properties" : {
          "schemaVersion" : {
            "const" : 1
          },
          "weekEnding" : {
            "type" : "string",
            "pattern" : "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "verdicts" : {
            "type" : "array",
            "items" : {
              "type" : "object",
              "additionalProperties" : false,
              "required" : [ "decisionId", "thesisHeld", "note" ],
              "properties" : {
                "decisionId" : {
                  "type" : "integer"
                },
                "thesisHeld" : {
                  "enum" : [ "유지", "반증", "판단불가" ]
                },
                "note" : {
                  "type" : "string"
                }
              }
            }
          },
          "recurringErrors" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "keep" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "proposal" : {
            "type" : [ "object", "null" ],
            "additionalProperties" : false,
            "required" : [ "operations", "judgment", "rationale" ],
            "properties" : {
              "operations" : {
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "additionalProperties" : false,
                  "required" : [ "op", "target", "text", "why" ],
                  "properties" : {
                    "op" : {
                      "enum" : [ "ADD_RULE", "UPDATE_RULE", "DELETE_RULE", "ADD_PRINCIPLE", "UPDATE_PRINCIPLE", "DELETE_PRINCIPLE" ]
                    },
                    "target" : {
                      "type" : "string"
                    },
                    "text" : {
                      "type" : [ "string", "null" ]
                    },
                    "why" : {
                      "type" : "string"
                    }
                  }
                }
              },
              "judgment" : {
                "type" : "string"
              },
              "rationale" : {
                "type" : "string"
              }
            }
          }
        }
      },
      "type" : "json_schema"
    }
  },
  "system" : [ {
    "text" : "<<고정본 review-system-us.txt>>",
    "type" : "text",
    "cache_control" : {
      "type" : "ephemeral"
    }
  } ]
}
