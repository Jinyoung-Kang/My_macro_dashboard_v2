{
  "type" : "object",
  "additionalProperties" : false,
  "required" : [ "schemaVersion", "stance", "targetEquityExposurePct", "exposureRationale", "summary", "orders", "noTradeReason", "confidence" ],
  "properties" : {
    "schemaVersion" : {
      "const" : 2
    },
    "stance" : {
      "enum" : [ "RISK_ON", "RISK_OFF", "NEUTRAL", "UNCERTAIN" ]
    },
    "targetEquityExposurePct" : {
      "type" : "number"
    },
    "exposureRationale" : {
      "type" : "string"
    },
    "summary" : {
      "type" : "string"
    },
    "orders" : {
      "type" : "array",
      "items" : {
        "type" : "object",
        "additionalProperties" : false,
        "required" : [ "ticker", "side", "timing", "executionNote", "thesis", "labels", "invalidation" ],
        "properties" : {
          "ticker" : {
            "type" : "string",
            "pattern" : "^[A-Z.\\-]{1,8}$"
          },
          "side" : {
            "enum" : [ "BUY", "SELL" ]
          },
          "targetWeightPct" : {
            "type" : [ "number", "null" ]
          },
          "sellFraction" : {
            "type" : [ "number", "null" ]
          },
          "timing" : {
            "enum" : [ "AT_MINUTE", "NEXT_CLOSE" ]
          },
          "atLocal" : {
            "type" : [ "string", "null" ],
            "pattern" : "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "executionNote" : {
            "type" : "string"
          },
          "thesis" : {
            "type" : "string"
          },
          "labels" : {
            "type" : "array",
            "items" : {
              "enum" : [ "사실", "해석", "가설", "확인 필요", "결정" ]
            }
          },
          "invalidation" : {
            "type" : "string"
          }
        }
      }
    },
    "noTradeReason" : {
      "type" : [ "string", "null" ]
    },
    "watchlist" : {
      "type" : "array",
      "items" : {
        "type" : "object",
        "additionalProperties" : false,
        "required" : [ "ticker", "condition" ],
        "properties" : {
          "ticker" : {
            "type" : "string"
          },
          "condition" : {
            "type" : "string"
          }
        }
      }
    },
    "checkpoints" : {
      "type" : "array",
      "items" : {
        "type" : "object",
        "additionalProperties" : false,
        "required" : [ "at", "feed", "watch", "question" ],
        "properties" : {
          "at" : {
            "type" : "string",
            "pattern" : "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "feed" : {
            "enum" : [ "MINUTE", "HOURLY" ]
          },
          "watch" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "pattern" : "^[A-Z.\\-]{1,8}$"
            }
          },
          "question" : {
            "type" : "string"
          }
        }
      }
    },
    "confidence" : {
      "type" : "number"
    }
  }
}
