<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.macrodash</groupId>
    <artifactId>macro-dashboard-backend</artifactId>
    <version>2.0.0</version>
    <name>Local Macro Dashboard Backend</name>
    <description>매크로 대시보드 API (저장본 읽기 · 분석 · 인증)</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 비밀번호 해시(Argon2id). Spring Security 전체가 아니라 해시 기능만 씁니다 — 버전은 Spring Boot BOM(7.1.2).
             세션은 DB에 두므로(ADR 0010) 서명 토큰(JWT) 라이브러리는 쓰지 않습니다. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Argon2 구현. spring-security-crypto의 Argon2PasswordEncoder가 요구합니다(BOM 관리 밖이라 버전을 적음). -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>

        <!-- 계정 메일(가입 인증·비밀번호 재설정) SMTP 발송. 버전은 Spring Boot BOM. MAIL_HOST가 비면 그 두 기능만 꺼집니다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Claude API (AI 리포트 엔진 Claude Haiku 5.5). 공식 SDK — 오류 종류·재시도·거절 응답을 타입으로 받습니다. -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.75.0</version>
        </dependency>

        <!-- Spring Boot 4는 테스트 지원도 기능별 모듈로 나뉩니다: MockMvc·웹 테스트, TestRestTemplate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TestRestTemplate이 RestTemplateBuilder를 씁니다(본 코드는 RestClient를 직접 만들어 필요 없음) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
