# =============================================================================
# .env.example — docker compose가 읽는 값들.
# 실제 값을 넣은 .env는 커밋하지 마세요(.gitignore에 있습니다).
#
# ⚠️ 키가 없어도 앱은 정상 실행됩니다. 키가 없는 기능만 비활성화됩니다.
# =============================================================================

# ---- 화면 접속 (계정, ADR 0010·0016) ----
# 처음 기동할 때 계정이 없으면 이 두 값으로 운영자 계정을 만듭니다. 그 뒤에는 읽지 않고, 비밀번호는 화면(내 계정)에서 바꿉니다.
# OWNER_EMAIL: 로그인 아이디로 쓸 이메일(기본값 없음 — 비어 있으면 계정을 만들지 않고 로그로 안내합니다).
# APP_PASSWORD: 비워 두면 'make setup'이 무작위 비밀번호를 만들어 넣고 한 번 보여 줍니다. 옛 기본값(admin1234@)은 받지 않습니다.
OWNER_EMAIL=
APP_PASSWORD=
# 로컬 화면의 로그인 화면을 없앨지. 비우면 true — 로그인 없이 위 운영자 계정으로 열립니다(계정이 먼저 있어야 함).
#   false면 로그인 화면을 거칩니다. 화면·API 포트는 이 값과 무관하게 늘 127.0.0.1(이 맥)에만 열립니다.
#   AWS 개인용 서버·QA 스택은 덧붙임 파일이 false로 고정해 이 값을 읽지 않습니다.
LOCAL_NO_LOGIN=

# ---- 계정 메일(가입 인증·비밀번호 재설정, 선택) ----
# 비어 있으면 가입·재설정 화면만 꺼지고 나머지는 그대로 동작합니다. 운영자는 메일 없이도 쓸 수 있습니다.
# 예: Gmail은 MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=주소, MAIL_PASSWORD=앱 비밀번호(일반 비밀번호 아님).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 보낸 사람(비면 MAIL_USERNAME). 메일 속 링크의 화면 주소(비면 FRONTEND_ORIGIN의 첫 값, 예: http://localhost:3002).
MAIL_FROM=
PUBLIC_URL=

# ---- 등급 ----
# 유료 회원의 하루(KST) AI 리포트 한도 — 유료 API 비용 상한. 운영자는 한도 없음, 무료 회원은 쓸 수 없음.
AI_DAILY_LIMIT=20

# ---- 읽기 모드: auto | store_only | live_only ----
#   auto       저장본이 신선하면 사용, 오래되면 수집기에 수집 요청 (기본)
#   store_only 저장본만 사용. 화면이 외부를 절대 기다리지 않음
#   live_only  신선해도 읽을 때마다 수집 요청(비동기, 태스크별 30초 쿨다운) — 저장본이 있으면 그대로 보여 줌 (디버깅용)
DASHBOARD_READ_MODE=auto

# ---- 비싼 계산 동시 실행 상한 (QA-131) ----
# 캐시에 없는 계산(스코어카드·기관 위험·13F 조합 등)을 동시에 몇 개까지 돌릴지. 비우거나 0이면 자동(코어 수의 절반, 최소 1).
# 넘친 요청은 2초 기다린 뒤 429('요청이 몰려…')를 받습니다. 보통 바꿀 일이 없습니다.
COMPUTE_MAX_CONCURRENT=

# ---- 🧪 모의 매매(운영자 전용) ----
# 정기 작업(5분 리스크 점검·하루 한 번 결정·출발일 종가 얼리기)을 켤지. 비우면 켜짐(true), false면 멈춤 — 수동 실행 버튼은 상관없이 돕니다.
PAPER_ENABLED=
# 🧪 한국 책 네 계좌의 출발 거래일(yyyy-MM-dd — S 22:30 결정 → S+1 시가, 2단계 명세 K25·K28). 기본값 없음: 비우면 한국 초기화·출발이
# 막히고 미국 책은 그대로입니다. 형식이 틀리면 백엔드가 기동하지 않습니다(거래일 검사는 한국 초기화·출발 때). 출발 절차에서 정합니다.
PAPER_KR_START_DATE=
# 13F 트랙레코드 수집(수집기 sec_13f_track_record, 12시간마다)이 한 번에 새로 내려받는 공시 수 상한(1~2000).
# 비우면 400 — 후보 27곳 30분기(약 810건)를 몇 번의 실행에 나눠 채우고, 그 뒤로는 새 분기 공시만 받습니다.
TRACK_RECORD_FETCH_BUDGET=
# 미국 종목 재무 수집(수집기 sec_fundamentals, 12시간마다 — SEC XBRL companyfacts)이 한 번에 보내는 요청(CIK) 수 상한(1~600).
# 비우면 200 — 유니버스 약 570곳을 세 번(약 36시간)에 한 바퀴 돕니다. SEC_USER_AGENT가 있어야 돕니다.
FUNDAMENTALS_FETCH_BUDGET=
# 미국 발표·실적 일정 수집(수집기 us_calendar, 1시간마다)이 한 번에 yfinance에 묻는 실적 일정 종목 수 상한(1~600).
# 비우면 120 — 종목마다 24시간 캐시라 평소에는 한 시간에 약 24종목만 묻고, 처음에는 약 5시간에 유니버스(ETF 제외)를 채웁니다.
US_CALENDAR_EARNINGS_BUDGET=
# 어닝 서프라이즈 수집(수집기 earnings_surprise, 12시간마다 — yfinance quoteSummary earnings)이 한 번에 묻는 종목 수 상한(1~600).
# 비우면 100 — 유니버스(ETF 제외) 약 576종목을 약 3일에 한 바퀴 돌고, 실적을 막 발표한 종목을 먼저 묻습니다.
EARNINGS_SURPRISE_BUDGET=

# ---- 수집 주기(초) ----
COLLECTOR_SCHEDULER=true
COLLECTOR_FAST_INTERVAL=300
COLLECTOR_SLOW_INTERVAL=3600
COLLECTOR_WEEKLY_INTERVAL=43200
# 수집 실행 기록 보존 기간(일, 최소 7). 수집한 데이터는 이 값과 무관하게 남습니다.
COLLECTOR_RUN_LOG_RETENTION_DAYS=90
# 백엔드→수집기 호출 토큰. 외부 API 키가 아니며 'make setup'이 무작위 값으로 채웁니다.
# 비어 있으면 수집기가 **기동하지 않습니다**. 인증 없이 띄워야 한다면(로컬 개발)
# COLLECTOR_ALLOW_NO_TOKEN=1을 함께 적으세요 — 경고만 남기고 뜹니다.
COLLECTOR_API_TOKEN=
# 수집기가 받는 Host 헤더 허용 목록(쉼표). 기본값은 localhost,127.0.0.1,[::1],collector 이며
# 보통 바꿀 일이 없습니다(DNS 리바인딩 방어).
# COLLECTOR_ALLOWED_HOSTS=

# ---- 외부 데이터 API ----
# FRED  https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# KRX   http://data.krx.co.kr
KRX_API_KEY=
# KRX 홈페이지 계정 (선택) — pykrx가 로그인 조회를 시도할 때만 씁니다.
#   비워 두면 pykrx를 비로그인으로 쓰고, KRX가 막으면 수급 레이더의 pykrx
#   단계만 건너뜁니다(KIS·Daum·Naver·누적 이력으로 대체).
KRX_ID=
KRX_PW=
# 한국투자증권  https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=
# LS증권 (선택) — "Open API"로 사용등록해야 합니다(모의투자 키는 서버가 다릅니다)
LS_APP_KEY=
LS_APP_SECRET=
# 토스증권 (선택, 연결 테스트 메뉴 전용)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# SEC EDGAR (13F 메뉴) — 키가 아니라 "연락처"입니다. ⚠️ 13F에는 필수입니다.
#   SEC는 연락처 없는 요청을 정책상 403으로 막습니다. 본인 이메일을 넣으세요.
#   비워 두면 13F 수집만 멈춥니다(나머지 메뉴는 정상 동작).
#   구버전 .streamlit/secrets.toml의 [sec] user_agent 와 같은 값입니다.
#   예) SEC_USER_AGENT=hong@example.com
SEC_USER_AGENT=

# ---- 국내 공공 API (선택) ----
# 공공데이터포털 https://www.data.go.kr — 마이페이지의 "일반 인증키".
#   계정당 키 하나로, 활용신청해 승인된 서비스 모두에 씁니다.
#   Encoding·Decoding 어느 쪽을 넣어도 됩니다(수집기가 한 형태로 맞춥니다).
#   이 키로 쓰는 서비스 (각각 활용신청 필요):
#     한국천문연구원_특일 정보           → 시계의 KRX 휴장일 (대체공휴일·선거일)
#     금융위원회_주식시세정보            → 국내 종목 공식 종가·시가총액
#   비워 두면 해당 수집만 멈추고, 시계는 내장 휴일 표(2025~2028)로 동작합니다.
DATA_GO_KR_SERVICE_KEY=
# 금융감독원 Open DART https://opendart.fss.or.kr — 인증키(40자리)
#   수급 레이더 종목의 재무 안정성·성장성(부채비율·매출/영업이익 증가율)
DART_API_KEY=

# ---- AI 엔진 (선택) ----
# 추론형 모델(gpt-oss, DeepSeek-R1 등)은 응답까지 몇 분이 걸릴 수 있습니다.
# 아래 한도는 화면에서 "엔진을 직접 고른 경우"에 적용됩니다.
# "N초 안에 응답하지 않았습니다"가 뜨면 이 값을 늘리거나 '⚡ 자동 탐색'을 쓰세요.
AI_TIMEOUT_SECONDS=240
# '⚡ 자동 탐색'은 빠른 엔진부터 부르고, 아래 두 한도로 대기 시간을 자릅니다.
#   AI_AUTO_ATTEMPT_SECONDS  엔진 하나를 기다리는 한도(넘으면 다음 엔진으로)
#   AI_AUTO_BUDGET_SECONDS   폴오버 전체 시간 예산(넘으면 남은 엔진은 시도하지 않음)
# 리포트가 너무 오래 걸리면 두 값을 줄이고, 자꾸 중간에 포기하면 늘리세요.
AI_AUTO_ATTEMPT_SECONDS=60
AI_AUTO_BUDGET_SECONDS=180
# Claude API (Haiku 5.5) — https://platform.claude.com 에서 발급. 유료(리포트 1건 약 1센트 미만).
#   넣으면 '⚡ 자동 탐색'이 Claude부터 부르고, 비우면 아래 무료 엔진만 씁니다.
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 쓸 엔진만 고르기(쉼표로 구분, 예: anthropic_haiku,cerebras_llama). 비우면 키가 있는 엔진을 모두 씁니다(기본).
#   목록 밖 엔진은 키가 있어도 부르지 않습니다. 모르는 ID면 백엔드가 기동하지 않습니다(ADR 0014).
AI_ENGINES=

# ---- 인프라 ----
# 화면·API·DB·수집기 포트는 모두 **이 맥(127.0.0.1)에서만** 열립니다 — 같은 와이파이의 다른 기기(휴대폰 등)에서는
# 접속할 수 없습니다. 로컬 화면은 로그인 없이 운영자로 열리므로 밖에 열지 않습니다(예전 WEB_BIND_HOST는 쓰지 않음).

# HTTPS(리버스 프록시 등)로만 접속한다면 true — 세션 쿠키에 Secure가 붙습니다.
# http://로 접속하면서 켜면 브라우저가 쿠키를 버려 로그인이 되지 않습니다(http://localhost만 예외 — Chrome·Firefox는 받고 Safari는 버림).
# AWS 개인용 서버는 compose.aws.yml이 기본 true로 둡니다 — 이 값(false)을 서버 .env에 옮기지 마세요(.env.aws.example).
# 로그인 없는 로컬(LOCAL_NO_LOGIN, 기본)과 함께 켜면 백엔드가 기동하지 않습니다 — LOCAL_NO_LOGIN=false와 함께 쓰세요.
COOKIE_SECURE=false

DATABASE_USER=macro
DATABASE_PASSWORD=macro
# make backup이 접두어별로 남기는 백업 파일 수(오래된 것부터 삭제). 0이면 지우지 않습니다.
BACKUP_KEEP=10
DATABASE_NAME=macrodash
# 이 저장소(My_macro_dashboard_v2)의 기본 포트 — 같은 맥의 Local_macro_dashboard_v3(3000/8080/8000/5432)·My_macro_dashboard_v1(3001/8081/8001/5433)과 함께 띄울 수 있게 +2.
DATABASE_PORT=5434
BACKEND_PORT=8082
COLLECTOR_PORT=8002
FRONTEND_PORT=3002
# 아래 두 값은 비워 두면 위 포트를 따라갑니다(권장). 포트 충돌로 BACKEND_PORT만
# 바꿔도 화면이 새 주소를 찾습니다. 리버스 프록시·다른 호스트 이름으로 접속할 때만
# 직접 적으세요(이때는 LOCAL_NO_LOGIN=false — 로그인 없는 로컬은 이 맥의 http 주소만 받습니다).
# 적은 값이 포트와 어긋나거나 로그인 없는 로컬과 맞지 않으면 make up이 기동 전에 알려 줍니다.
# FRONTEND_ORIGIN=http://localhost:3002
# NEXT_PUBLIC_API_BASE=http://localhost:8082

# ---- AWS 개인용 서버 (ADR 0019) — 이 PC의 scripts/aws/tunnel.sh만 읽습니다 ----
# 서버 EC2(my-macro-app)의 인스턴스 ID(i-로 시작). 비밀값은 아니지만 계정마다 달라 여기에만 둡니다. 서버 .env에는 적지 않습니다(.env.aws.example).
AWS_INSTANCE_ID=
