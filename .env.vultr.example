# Vultr 서버(서울 my-macro-app)의 .env — 이름만 적습니다(값은 서버의 ~/My_macro_dashboard_v2/.env에만, chmod 600).
# compose.vultr.yml · ADR 0023 참고. .env.aws.example(AWS 서버)에서 갈라냈습니다.
#
# 서버 .env = 로컬 .env(.env.example의 이름들)에서 아래 '적지 않는 이름'을 뺀 것 + 아래 '서버 전용' 줄들.
# PC → 서버는 파일째 scp하지 않고 docs/DEVELOPMENT.md §7 '서버 .env 전달' 절차로 — 옮길 줄만 걸러 Tailscale SSH(ssh ubuntu@my-macro-app)의
# 입력으로 보내고, 서버 전용 줄은 서버의 지금 .env에서 그대로 이어 붙입니다(권한 600).
#
# 주의: 서버 .env에 적지 않는 이름 — scripts/vultr/deploy.sh는 아래 이름이 있으면 배포하지 않습니다(이름만 알림)
#   · 포트 네 줄 DATABASE_PORT·BACKEND_PORT·COLLECTOR_PORT·FRONTEND_PORT — 로컬은 v3·v1과 함께 띄우려고 5434/8082/8002/3002를
#     쓰지만, 서버는 기본값(127.0.0.1의 5432/8080/8000/3000)을 씁니다. 앞단 Caddy는 컨테이너 안 포트로 붙습니다.
#   · LOCAL_NO_LOGIN·FRONTEND_ORIGIN·PUBLIC_URL — compose.vultr.yml이 값을 박아 두어 적어도 쓰이지 않습니다(로그인은 늘 켜짐, ADR 0016).
#   · ORIGIN_SECRET·GATE_SECRET·GATE_CODES·GATE_HOURS — AWS 공개 주소(CloudFront + 잠금화면)의 값. Vultr에는 공개 주소·gate가 없습니다.
#   · AWS_INSTANCE_ID·VULTR_*·TAILSCALE_*·TAILNET_DOMAIN — PC에서만 쓰는 값입니다(API 키·auth key 같은 비밀값이 섞임). AWS_INSTANCE_ID는
#     2026-11-03에 지운 AWS 서버(ADR 0019)의 PC 스크립트가 읽던 값이라, 로컬 .env에 남아 있어도 서버로 옮기지 않습니다.
# 적으면 알리기만 하는 이름
#   · COOKIE_SECURE — 로컬 값(false)이 들어오면 compose.vultr.yml의 기본값 true(세션 쿠키에 Secure)를 덮어씁니다. 옮기지 않습니다.
#     브라우저가 로그인 쿠키를 받지 못할 때만 COOKIE_SECURE=false를 적고 ADR 0023에 기록합니다.
#   · PAPER_ENABLED — 로컬 .env의 false를 옮기지 않습니다(서버는 비우면 켜짐). 서버 정기 작업을 일부러 끌 때만 서버에서 직접 적습니다.
#
# 모의 매매 정기 작업은 이 서버 한 곳에서만 돕니다(ADR 0019·0020·0023 — 2026-11-03 02:30 KST 컷오버. 그 전 AWS와 병행하던 동안은 PAPER_ENABLED=false였음).

# ── 서버 전용 ──
# compose 파일 두 개를 늘 함께 읽게 합니다 — 서버에서 make backup·make restore·make logs·docker compose ps가 덧붙임까지 봅니다
# (deploy.sh·backup-s3.sh는 이 값과 상관없이 같은 값을 씀). 비밀값이 아니라 이 값 그대로 적습니다.
COMPOSE_FILE=docker-compose.yml:compose.vultr.yml
# DB 백업을 올릴 S3 버킷 이름(scripts/vultr/backup-s3.sh, cron 매일 08:00 KST·일 23:00 KST → db/vultr/ — 2026-11-07 배포 전까지는 06:45,
# ADR 0023). 옛 AWS 서버(2026-11-03 삭제)가 쓰던 것과 같은 버킷입니다.
# 인증은 서버 ubuntu의 ~/.aws/credentials(이 버킷 하나만 쓰는 IAM 사용자 키) — 여기에 키를 적지 않습니다.
AWS_BACKUP_BUCKET=
# 화면 주소 https://my-macro-app.<tailnet>.ts.net — tailnet 이름은 계정 고유 값이라 저장소에 적지 않습니다(로컬 .env의 TAILNET_DOMAIN).
# 백엔드 허용 출처·알림 링크(필수 — 비면 뜨지 않음).
PUBLIC_ORIGIN=
# Tailscale 신원 자동 로그인(ADR 0023) — 이 Tailscale 사용자(관리 콘솔 Users의 로그인 이름)가 Serve로 열면 로그인 없이 운영자. 비면 늘 로그인 화면.
# 서버에서 `tailscale status --json`의 User 목록 LoginName과 같은 값. 계정 고유 값이라 저장소에 적지 않습니다.
TAILNET_OWNER_LOGIN=
# 토스 실제 계좌 읽기 전용 조회(ADR 0025) — true일 때만 모의매매(한국·미국) 화면의 '실제 계좌' 탭이 토스증권 실제 계좌를 읽습니다(비우거나 없으면 꺼짐).
# 켜는 곳은 이 서버 하나입니다 — 토큰은 키 하나에 1개이고 토스 허용 IP는 서버 IP, 로컬 compose는 "false" 고정. 처음에는 적지 않고 배포해 정상인지 본 뒤
# 덧붙이고 다시 배포합니다(docs/DEVELOPMENT.md §7). 로컬 .env를 다시 전달해도 서버 전용 줄은 서버에서 그대로 이어 붙입니다(docs/DEVELOPMENT.md §7 '서버 .env 전달').
TOSS_ACCOUNT_ENABLED=
# 토스 실제 계좌의 실제 매매(ADR 0028 · 명세 docs/specs/2026-11-06-real-trade-mirror.md) — 서버 스위치 둘과 한도 넷. 비우거나 없으면 꺼짐이고, 화면 스위치
# (운영자가 '실제 매매 켜기' — 확인 글자 + 비밀번호)까지 셋이 모두 켜져야 주문이 나갑니다. 켜는 곳은 이 서버 하나이며 TOSS_ACCOUNT_ENABLED=true가 먼저 있어야 합니다.
# 처음에는 적지 않고 배포해 정상인지 본 뒤, 값을 사용자에게 확인받아 덧붙이고 다시 배포합니다(docs/DEVELOPMENT.md §7 '실제 매매 켜기'). 로컬 .env를 다시 전달해도
# 서버 전용 줄은 서버에서 그대로 이어 붙입니다(docs/DEVELOPMENT.md §7). 끄려면 TOSS_TRADING_ENABLED=false로 바꾸고 수집기만 다시 만듭니다(docker compose up -d --no-deps --no-build collector — deploy.sh 아님, 비상 끄기는 같은 절 3단계). 그러면 백엔드가 이상 멈춤(collector-disabled)으로 두므로 다시 켤 때는 스위치를 되돌린 뒤 화면에서 멈춤 해제.
#   TOSS_TRADING_ENABLED  수집기 주문 경로 — 정확히 true일 때만(그리고 아래 한도 넷이 모두 맞을 때만) 켜짐
#   REAL_TRADE_ENABLED    백엔드 실제 매매 정기 작업 — true일 때만 돎
TOSS_TRADING_ENABLED=
REAL_TRADE_ENABLED=
# 한도(원·건 — 쉼표·밑줄 없는 정수) — 하나라도 없거나 정수가 아니거나 범위 밖이면 수집기가 매매를 끕니다(limits-invalid). 수집기는 백엔드 값을 믿지 않고 토스에서 직접 센 값으로 비교합니다.
#   TOSS_TRADING_MAX_ORDER_KRW        1건 금액 상한(매수는 상한가 × 수량, 매도는 현재가 × 수량) — 1 이상 99,999,999 이하. 넘는 주문은 쪼개지 않고 상한까지만
#   TOSS_TRADING_MAX_ORDERS_PER_DAY   오늘(KST) 국내 주문 건수 상한(앱 주문 포함) — 1~200
#   TOSS_TRADING_MAX_BUY_KRW_PER_DAY  오늘 국내 매수 금액 합 상한(체결 금액 + 미체결 수량 × 상한가, 앱 주문 포함) — 1 이상
#   TOSS_TRADING_MAX_EQUITY_KRW       운용 평가액 상한 — 원화 매수 가능 금액 + 국내 보유 평가액이 이것을 넘으면 넘는 부분은 현금으로 둠 — 1 이상
TOSS_TRADING_MAX_ORDER_KRW=
TOSS_TRADING_MAX_ORDERS_PER_DAY=
TOSS_TRADING_MAX_BUY_KRW_PER_DAY=
TOSS_TRADING_MAX_EQUITY_KRW=
# 한국 책 출발 거래일 — 로컬 .env에는 없어(비움) 서버에 적습니다. 비면 한국 초기화·출발이 막힙니다(이미 출발한 계좌의 값 그대로).
PAPER_KR_START_DATE=2026-10-30
# (선택) 모의 매매 텔레그램 알림 — 체결·결정·주문(백엔드, 설정 notify.telegram). 둘 다 있어야 보내고, PAPER_ENABLED=false면 이 알림은 보내지 않습니다.
# scripts/vultr/backup-s3.sh의 백업 실패 알림(QA-199)도 같은 두 값을 쓰며, 이것은 PAPER_ENABLED와 상관없이 보냅니다 — 비우면 백업 실패 알림도 없습니다.
# 비밀값(TELEGRAM_BOT_TOKEN)은 화면·로그·커밋에 내지 않습니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# (선택) 알림 종류별 봇 — 위 두 값이 운영 봇(수집 출처 닫힘·백업 실패)이고, 아래 토큰이 비면 그 알림도 운영 봇으로 갑니다. 대화방은 TELEGRAM_CHAT_ID 하나를 함께 씁니다.
# 미국 모의 계좌 · 한국 모의 계좌 · 실제 계좌와 ISA 순서입니다.
TELEGRAM_US_BOT_TOKEN=
TELEGRAM_KR_BOT_TOKEN=
TELEGRAM_ACCOUNT_BOT_TOKEN=
# (선택) 차단 통과 수집 계층의 계층 2 — 브라우저 컨테이너(ADR 0026). 둘 다 있어야 수집기가 브라우저 컨테이너를 부릅니다(비면 계층 1까지만 — 거부되면 그 출처는 닫힘).
# 주소는 http://browser:8191(compose 안쪽 이름 — 비밀값 아님). 공유 비밀은 서버에서만 만들어 덧붙이고(docs/DEVELOPMENT.md §7) 로컬 .env에는 두지 않습니다.
# 끄려면 BROWSER_FETCH_URL 줄을 지우고 다시 배포합니다. 로컬 .env를 다시 전달해도 서버 전용 줄은 서버에서 그대로 이어 붙입니다(docs/DEVELOPMENT.md §7 '서버 .env 전달').
BROWSER_FETCH_URL=
BROWSER_FETCH_TOKEN=
# Chrome 샌드박스가 이 서버에서 뜨지 않을 때만 false를 적고 ADR 0026에 기록합니다. 비우면 켜짐.
BROWSER_SANDBOX=
# (선택) 브라우저 계층이 사람 확인의 입력 없는 체크박스만 한 번 누르는 것(ADR 0035 결정 5)을 끌 때만 false. 비우면 켜짐(퍼즐은 늘 풀지 않음).
BROWSER_PRESS_CHECKBOX=
# (선택) 차단 통과 수집(polite 속도군 — TradingView 캘린더·정보 수집, ADR 0035)을 잠시 멈출 때만 false. 비우면 켜짐. 로컬·QA compose는 늘 꺼짐.
POLITE_FETCH_ENABLED=
