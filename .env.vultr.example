# Vultr 서버(서울 my-macro-app)의 .env — 이름만 적습니다(값은 서버의 ~/My_macro_dashboard_v2/.env에만, chmod 600).
# compose.vultr.yml · ADR 0023 참고. .env.aws.example(AWS 서버)에서 갈라냈습니다.
#
# 서버 .env = 로컬 .env(.env.example의 이름들)에서 아래 '적지 않는 이름'을 뺀 것 + 아래 '서버 전용' 줄들.
# PC → 서버는 scp(Tailscale SSH: ssh ubuntu@my-macro-app, 또는 비상용 -i ~/.ssh/id_ed25519_vultr), 서버에서 chmod 600.
#
# 주의: 서버 .env에 적지 않는 이름 — scripts/vultr/deploy.sh는 아래 이름이 있으면 배포하지 않습니다(이름만 알림)
#   · 포트 네 줄 DATABASE_PORT·BACKEND_PORT·COLLECTOR_PORT·FRONTEND_PORT — 로컬은 v3·v1과 함께 띄우려고 5434/8082/8002/3002를
#     쓰지만, 서버는 기본값(127.0.0.1의 5432/8080/8000/3000)을 씁니다. 앞단 Caddy는 컨테이너 안 포트로 붙습니다.
#   · LOCAL_NO_LOGIN·FRONTEND_ORIGIN·PUBLIC_URL — compose.vultr.yml이 값을 박아 두어 적어도 쓰이지 않습니다(로그인은 늘 켜짐, ADR 0016).
#   · ORIGIN_SECRET·GATE_SECRET·GATE_CODES·GATE_HOURS — AWS 공개 주소(CloudFront + 잠금화면)의 값. Vultr에는 공개 주소·gate가 없습니다.
#   · AWS_INSTANCE_ID·VULTR_*·TAILSCALE_*·TAILNET_DOMAIN — PC의 scripts/aws·scripts/vultr만 읽습니다(API 키·auth key 같은 비밀값이 섞임).
# 적으면 알리기만 하는 이름
#   · COOKIE_SECURE — 로컬 값(false)이 들어오면 compose.vultr.yml의 기본값 true(세션 쿠키에 Secure)를 덮어씁니다. 옮기지 않습니다.
#     브라우저가 로그인 쿠키를 받지 못할 때만 COOKIE_SECURE=false를 적고 ADR 0023에 기록합니다.
#   · PAPER_ENABLED — 로컬 .env의 false를 옮기지 않습니다(서버는 비우면 켜짐). 서버 정기 작업을 일부러 끌 때만 서버에서 직접 적습니다.
#
# 모의 매매 정기 작업은 이 서버 한 곳에서만 돕니다(ADR 0019·0020·0023 — 2026-11-03 02:30 KST 컷오버. 그 전 AWS와 병행하던 동안은 PAPER_ENABLED=false였음).

# ── 서버 전용 ──
# compose 파일 두 개를 늘 함께 읽게 합니다 — 서버에서 make backup·make restore·make logs·docker compose ps가 덧붙임까지 봅니다
# (deploy.sh·backup-s3.sh는 이 값과 상관없이 같은 값을 씀). 비밀값이 아니라 이 값 그대로 적습니다.
COMPOSE_FILE=docker-compose.yml:compose.vultr.yml
# DB 백업을 올릴 S3 버킷 이름(scripts/vultr/backup-s3.sh, cron 06:45 KST·일 23:00 KST → db/vultr/). AWS 서버와 같은 버킷입니다.
# 인증은 서버 ubuntu의 ~/.aws/credentials(이 버킷 하나만 쓰는 IAM 사용자 키) — 여기에 키를 적지 않습니다.
AWS_BACKUP_BUCKET=
# 화면 주소 https://my-macro-app.<tailnet>.ts.net — tailnet 이름은 계정 고유 값이라 저장소에 적지 않습니다(로컬 .env의 TAILNET_DOMAIN).
# 백엔드 허용 출처·알림 링크(필수 — 비면 뜨지 않음).
PUBLIC_ORIGIN=
# Tailscale 신원 자동 로그인(ADR 0023) — 이 Tailscale 사용자(관리 콘솔 Users의 로그인 이름)가 Serve로 열면 로그인 없이 운영자. 비면 늘 로그인 화면.
# 서버에서 `tailscale status --json`의 User 목록 LoginName과 같은 값. 계정 고유 값이라 저장소에 적지 않습니다.
TAILNET_OWNER_LOGIN=
# 한국 책 출발 거래일 — 로컬 .env에는 없어(비움) 서버에 적습니다. 비면 한국 초기화·출발이 막힙니다(이미 출발한 계좌의 값 그대로).
PAPER_KR_START_DATE=2026-10-30
# (선택) 모의 매매 텔레그램 알림 — 체결·결정·주문(백엔드, 설정 notify.telegram). 둘 다 있어야 보냅니다. PAPER_ENABLED=false면 보내지 않습니다.
# 비밀값(TELEGRAM_BOT_TOKEN)은 화면·로그·커밋에 내지 않습니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
